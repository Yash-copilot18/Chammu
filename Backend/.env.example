# Chammu backend configuration.
#
# Copy to `.env` in this folder and fill in. `.env` is never committed.
#     Copy-Item .env.example .env

# ── Database ─────────────────────────────────────────────────────────────────
DB_SERVER=YOUR_SQL_HOST\SQLEXPRESS
DB_DATABASE=CHAMMU
DB_DRIVER=ODBC Driver 17 for SQL Server

# Authentication. Leave both blank for Windows Authentication, which is the
# better option wherever it works because nothing has to be stored.
#
# Fill them in for an instance in mixed mode that you reach with a SQL login
# (the "SQL Server Authentication" option in SSMS). A trusted connection
# cannot open such an instance at all, so this is not a preference.
#
# Setting DB_USERNAME without DB_PASSWORD is refused at startup rather than
# quietly falling back to Windows auth and failing somewhere less obvious.
#
# Prefer a least-privilege login scoped to this one database over `sa`, which
# is the highest-privilege account on the whole instance. Whatever you use, the
# password sits in plain text in this file — .env is git-ignored, and it must
# stay that way.
DB_USERNAME=
DB_PASSWORD=

# ── Application ──────────────────────────────────────────────────────────────
# Name this API reports in /health, / and the docs title. It was hardcoded
# to the original project, so a deployment announced itself as another
# plant's system to anyone who called /health.
APP_NAME=Chammu Solar Monitoring API
APP_ENV=production
APP_HOST=0.0.0.0
# 8001 so this runs alongside another plant's API on 8000 rather than fighting it.
APP_PORT=8001

# Vite takes 5173 when free and steps to 5174/5175/5176 when it is not. The
# browser sends whichever port it actually got, so all four are listed — a
# shifted port is then a non-event instead of a wall of CORS errors.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5273,http://localhost:3000

# Forecasting only. Set to 1 to register the reporting routers as well — they
# query tables CHAMMU does not have and will fail at request time until each is
# mapped onto this plant's schema.
ENABLE_ALL_FEATURES=

# ── Inverter fleet ───────────────────────────────────────────────────────────
# CHAMMU names its tables INVERTER_1 .. INVERTER_12 — twelve, unpadded. A plant
# using INVERTER_01 .. INVERTER_24 would set 24 and a pad of 2.
INVERTER_COUNT=12
INVERTER_NAME_PAD=0
# Below this an inverter counts as not running (kW).
INVERTER_RUNNING_KW=1.0

# ── Forecast horizons and validation ─────────────────────────────────────────
# Days predicted forward: 30, so the UI can show next-day, 7-day and 30-day
# figures. Only day 1 is validated by the backtest.
FORECAST_DAYS=30

# How many inverters are fitted at the same time during a device run.
# Each device fits all five candidate models across every fold, and those fits
# share nothing, so they run in separate processes. Leave it unset (or 0) for
# automatic, which uses every core but one and leaves the server responsive
# while a run is in progress. Set it to 1 to go back to one device at a time:
# the numbers are identical either way, it is only slower.
# Measured on a 12-core machine, 12 inverters: 77s serial, 17s automatic.
# DEVICE_FORECAST_WORKERS=

# Smallest training block, in days. 45 suits a plant with a long archive;
# CHAMMU has 42 complete days in total, so at 45 no run can start. Lowered so a
# provisional model can be produced and seen — never to flatter a score.
MIN_TRAIN_DAYS=21

# A held-out block smaller than this gives a score dominated by which days
# happened to land in it. Below this the reliability banner reads INSUFFICIENT
# DATA and `target_met` stays false whatever the score says.
MIN_CREDIBLE_TEST_DAYS=30

# ── Plant capacity ───────────────────────────────────────────────────────────
# Used ONLY for Performance Ratio. Left blank deliberately: nameplate has not
# been supplied for this plant, and a guessed capacity produces a PR figure
# that looks authoritative and is not. Measured peak is about 38 MW.
INSTALLED_CAPACITY_MW=

# ── Site latitude ────────────────────────────────────────────────────────────
# Blank disables quality-control rule C4 (the clear-sky ceiling on daily
# irradiance) rather than checking this plant's sky against another site's.
# Peak and latched-sensor checks still run. Set in decimal degrees to enable.
WEATHER_LAT=
WEATHER_LON=

# ── Weather provider ─────────────────────────────────────────────────────────
# Unconfigured. Enabling needs the plant's real coordinates AND a commercially
# licensed provider plan — the free Open-Meteo tier is evaluation-only. Until
# both exist the forecast runs on plant history alone and the UI says so.
WEATHER_PROVIDER=

# ── E-mail ───────────────────────────────────────────────────────────────────
# Not used in a forecasting-only build. Leave blank unless scheduled reports
# are switched on. Never commit real credentials: for Gmail use a 16-character
# App Password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
REPORT_RECIPIENT_EMAIL=
