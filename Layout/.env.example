# SolarOps — build-time configuration (Vite).
#
# Copy to `.env` (local) or `.env.production` (deployment).
# Vite inlines VITE_* values AT BUILD TIME — rebuild after changing them, and never
# put a secret here: everything in this file ships to the browser.


# ── Single-plant deployment ───────────────────────────────────────────────────
# The backend for the one plant this build serves. Used when VITE_SITES is not set.
# Without it the app falls back to http://localhost:8000, which silently breaks
# every request for users on other machines.
#
# The Chammu backend listens on 8001 (Backend/.env, APP_PORT), chosen so it can
# run alongside another plant'''s API on 8000.
VITE_API_URL=http://localhost:8001


# ── Multi-plant deployment ────────────────────────────────────────────────────
# A JSON array of the plants this build serves, shown in the header's site picker.
# When set, it takes precedence over VITE_API_URL.
#
# IMPORTANT: each site needs its OWN apiUrl. The API has no site dimension — every
# endpoint answers for the single plant its database is attached to — so switching
# site must switch backend. A site with no apiUrl is labelled "Not connected" and
# its pages render empty rather than showing the previous plant's figures.
#
# Fields: id and name are required. Everything else is optional and renders as an
# em dash when absent. None of these are measurements; they are labels you supply.
#
#   id              stable key, used in local storage, never displayed
#   name            'Northfield Solar Park'
#   shortName       header chip when space is tight; falls back to name
#   location        'Konya, Türkiye'
#   capacityMw      AC capacity, MW
#   dcCapacityMwp   DC capacity, MWp
#   inverters       equipment counts
#   trackers
#   strings
#   commissioned    'YYYY-MM'
#   timezone        IANA name or a display label
#   currency
#   apiUrl          backend for this site, no trailing slash
#
# Must be one line. Example:
#
# VITE_SITES=[{"id":"north","name":"Northfield Solar Park","location":"Konya","capacityMw":130,"inverters":64,"apiUrl":"https://north.example.com"},{"id":"south","name":"Southgate Solar Park","location":"Antalya","capacityMw":85,"inverters":42,"apiUrl":"https://south.example.com"}]
